<Window x:Class="csharp_DBCourseWork_sem5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_DBCourseWork_sem5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStyle="None"
        FontFamily="Bahnschrift" FontSize="25" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/MainWinBack.jpg" Grid.RowSpan="4" Grid.Column="0" Grid.Row="1" Stretch="Fill"/>

        <GridSplitter Grid.Column="1" Grid.RowSpan="4" Width="5" Background="AliceBlue"
            HorizontalAlignment="Center" VerticalAlignment="Stretch"
            ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="2" Grid.Row="1">
            <TextBlock Text="UP" TextAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <GridSplitter Grid.Column="2" Grid.Row="2" Height="5" Background="AliceBlue"
            HorizontalAlignment="Stretch" VerticalAlignment="Center"
            ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="2" Grid.Row="3">
            <DataGrid x:Name="dgBooks" Margin="10" AutoGenerateColumns="True" Panel.ZIndex="3" FontSize="10"/>
        </Border>

        <Rectangle Fill="Black" Width="auto" Height="40" Grid.ColumnSpan="3" Grid.Row="0"/>

        <Border Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="auto" Margin="0,0,5,0" Grid.Column="2" MouseLeftButtonUp="Close_Click">
            <Label Content="x" Foreground="white" ToolTip="Закрыть"/>
        </Border>
        
        <Label Content="?" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,2,35,0" ToolTip="Справка" Cursor="Help" Grid.Column="2">
            <Label.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Руководство пользователя" Click="OpenPage_Click"/>
                    <MenuItem Header="О программе" Click="OpenPage_Click"/>
                </ContextMenu>
            </Label.ContextMenu>
        </Label>

        <Frame Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" Name="fmPage" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>