<Window x:Class="csharp_DBCourseWork_sem5.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_DBCourseWork_sem5"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="450" WindowStyle="None" 
        FontFamily="Bahnschrift" FontSize="25" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Visibility="Visible" Name="winLogin">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/LogWinBack.jpg" Panel.ZIndex="-20" Grid.ColumnSpan="3" Grid.RowSpan="3"/>

        <Grid Grid.Row="1" Grid.Column="1" Name="grdLogin" Visibility="Visible">
            <Rectangle Fill="#80FFFFFF" Width="300" Height="200" Grid.Column="1" Grid.Row="1" RadiusX="20" RadiusY="20"/>
            <StackPanel Grid.Column="1" Grid.Row="1" Height="auto" Width="260" Margin="10" VerticalAlignment="Center">
                <Image Source="/Images/UserIcon.png" Height="64" Width="64" Margin="5"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/Images/UserIcon2.png" Height="40" Width="40"/>

                    <Border CornerRadius="10" BorderThickness="2.5" BorderBrush="White" Padding="8,0" Margin="3">
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White"
                            MinHeight="30" MinWidth="150" MaxWidth="150" Text="Логин"
                            VerticalContentAlignment="Center" ToolTip="Введите логин" Height="40"
                            MouseEnter="txtLoginPass_MouseEnter" Name="txtLogin"/>
                    </Border>
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/Images/LockIcon.png" Height="40" Width="40"/>

                    <Border CornerRadius="10" BorderThickness="2.5" BorderBrush="White" Padding="8,0" Margin="3">
                        <PasswordBox Background="Transparent" BorderThickness="0" Foreground="White"
                             MinHeight="30" MinWidth="150" MaxWidth="150" Height="40" VerticalContentAlignment="Center" 
                             ToolTip="Введите пароль" Password="Пароль"
                             Name="txtPass"/>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <Border Height="50" Width="240" CornerRadius="10" BorderThickness="0.5" 
                    Background="#80FFFFFF" Padding="8,0" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" Margin="15"
                    Cursor="Hand" Name="brdLogin" MouseDown="Login_Click" 
                    MouseEnter="brdLogin_MouseEnter" MouseLeave="brdLogin_MouseLeave" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <TextBlock Background="Transparent" FontSize="20" Text="Войти" Foreground="White" TextAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Rectangle Fill="Black" VerticalAlignment="Top" Width="auto" Height="40" Grid.ColumnSpan="3"/>

        <Label Cursor="Hand" Content="x" Foreground="white" ToolTip="Закрыть" Grid.Column="2" 
               HorizontalAlignment="Right" Margin="0,0,5,0" MouseLeftButtonUp="Close_Click"/>

        <Label Grid.Column="2" Content="?" Foreground="white" HorizontalAlignment="Right" Margin="0,2,35,0" ToolTip="Справка" Cursor="Help" >
            <Label.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Руководство пользователя" Click="OpenPage_Click"/>
                    <MenuItem Header="О программе" Click="OpenPage_Click"/>
                </ContextMenu>
            </Label.ContextMenu>
        </Label>

        <Frame Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" Name="fmPage" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
    </Grid>
</Window>
