<Page x:Class="csharp_DBCourseWork_sem5.UserManualPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:csharp_DBCourseWork_sem5"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserManualPage" FontFamily="Bahnschrift" FontSize="25">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Grid.RowSpan="2">
            <TextBlock Text="Руководство пользователя"
                       Background="AliceBlue" Foreground="Black" 
                       FontSize="30" TextAlignment="Center" Padding="30" Height="100"/>
            <RichTextBox BorderThickness="0" Height="350"/>
        </StackPanel>

    </Grid>
</Page>
